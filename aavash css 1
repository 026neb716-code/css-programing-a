<!DOCTYPE html>
<html>
<head>
    <title>CSS Example</title>

    <style>
        /* CSS is used to style HTML elements */

        p {
            /* Changes text color */
            color: blue;

            /* Sets background color */
            background-color: lightgray;

            /* Sets text size */
            font-size: 20px;

            /* Sets font style */
            font-family: Arial;

            /* Aligns text in the center */
            text-align: center;

            /* Adds space inside the paragraph */
            padding: 15px;

            /* Adds border */
            border: 2px solid black;

            /* Rounds the corners */
            border-radius: 10px;
        }
    </style>
</head>

<body>
    </body>
    </html>
